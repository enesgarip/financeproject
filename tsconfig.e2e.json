{
  // tests/e2e spec'leri doğrudan ../../src/utils'ten import eder ama bugüne dek
  // hiçbir tsconfig'e dahil değildi: bir export silindiğinde lint+test:unit+build
  // üçü yeşil kalıyor, hata PR SONRASI CI Playwright'ta patlıyordu (CLAUDE.md'nin
  // belgeli gotcha'sı). Bu proje `tsc -b` kapsamına girerek tuzağı kökten kapatır;
  // playwright/vitest config dosyaları da (node.json yalnız vite.config.ts
  // içeriyordu) ilk kez tip denetimine girer.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    /* Bundler mode (app/node ile aynı) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests", "playwright.config.ts", "vitest.config.ts", "vitest.twin.config.ts"]
}
